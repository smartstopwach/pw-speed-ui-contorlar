{
  "manifest_version": 3,
  "name": "PW Speed Controller + Clean View",
  "version": "1.5.0",
  "description": "Up Arrow = 2x speed, Down Arrow = 1x speed on PW/YouTube lectures. Manual speed changes are respected. Press T to hide/show all on-screen toggles for a clean view.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.pw.live/*",
        "*://*.physicswallah.live/*"
      ],
      "js": ["content.js"],
      "css": ["clean.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
